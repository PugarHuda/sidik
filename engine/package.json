{
  "name": "@sidik/engine",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "fixtures": "tsx --env-file-if-exists=.env scripts/gen-fixtures.mts",
    "listings": "tsx --env-file-if-exists=.env scripts/gen-listings.mts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "coverage": "vitest run --coverage --exclude '**/*.integration.test.ts'",
    "verification": "tsx --env-file-if-exists=.env scripts/gen-verification.mts",
    "reproduce": "tsx --env-file-if-exists=.env scripts/reproduce.mts",
    "counts": "tsx scripts/counts.mts",
    "scanners": "tsx --env-file-if-exists=.env scripts/gen-scanners.mts",
    "recheck": "tsx --env-file-if-exists=.env scripts/recheck.mts",
    "selector-names": "tsx --env-file-if-exists=.env scripts/gen-selector-names.mts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.48",
    "@hono/node-server": "^1",
    "@sidik/shared": "workspace:*",
    "ai": "^5",
    "get-port": "^7",
    "hono": "^4",
    "viem": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "exports": {
    "./orchestrator": "./src/orchestrator.ts",
    "./concurrency": "./src/concurrency.ts",
    "./head": "./src/head.ts",
    "./mcp": "./src/mcp.ts"
  }
}
